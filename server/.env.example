# Server Configuration
PORT=5000

# Google Gemini API Key (Default fallback if client doesn't supply one via header)
# Get a key from https://aistudio.google.com/
GEMINI_API_KEY=

# Supabase Configuration (Optional on backend if using direct client-side Supabase, or for service role)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
